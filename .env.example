# Copy this file to .env.local and fill in the values (Part F1).
# Add the same variables in Vercel → Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API Keys) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# Publishable key (sb_publishable_...). Safe in the browser: RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...). SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Website -----------------------------------------------------------------
# Used for SEO, share links and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp support button, digits only with country code (e.g. 94XXXXXXXXX).
# The number typed in Admin → Settings wins; this one is the fallback.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Google Search Console → Add property (URL prefix) → "HTML tag" → copy only the
# content="..." value. Optional; set it on launch day (Part F4.5).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
